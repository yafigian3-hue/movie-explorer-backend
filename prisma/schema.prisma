datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int        @id @default(autoincrement())
  name      String     @default("Pengguna")
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())

  favorites Favorite[]
  watchlist Watchlist[]
  history   History[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  movieId   Int
  title     String
  image     String
  rating    Float
  year      Int
  genreIds  Int[]    @default([])

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Watchlist {
  id        Int      @id @default(autoincrement())
  movieId   Int
  title     String
  image     String?
  rating    Float?
  year      Int?
  genreIds  Int[]    @default([])

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model History {
  id        Int      @id @default(autoincrement())
  movieId   Int
  title     String
  image     String?
  rating    Float?
  year      Int?
  viewedAt  DateTime @default(now())
  genreIds  Int[]    @default([])

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}