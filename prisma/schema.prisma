datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Favorite {
  id        Int    @id
  title     String
  image     String
  rating    Float
  year      Int
  genreIds Int[]    @default([])
}

model Watchlist {
  id     Int    @id
  title  String
  image  String?
  rating Float?
  year   Int?
  genreIds Int[]    @default([])
} 

model History {
  id        Int      @id
  title     String
  image     String?
  rating    Float?
  year      Int?
  viewedAt  DateTime @default(now())
  genreIds Int[]    @default([])
}